generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  PASSIVE
  ARCHIVED
}

enum TicketCategory {
  SCRIPT_PURCHASE
  SUPPORT
  PAYMENT
  DELIVERY
  CUSTOM_PROJECT
  OTHER
}

enum TicketStatus {
  OPEN
  WAITING_STAFF
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PREPARING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum AccessType {
  LIFETIME
  TIMED
}

enum PaymentMethod {
  CRYPTO
}

enum PaymentStatus {
  PAID
  REFUNDED
}

enum LicenseStatus {
  ACTIVE
  REVOKED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
  LIFETIME
  FROZEN
}

enum ProjectStatus {
  APPROVED
  IN_PROGRESS
  WAITING
  DELIVERED
  CANCELLED
}

enum CounterKind {
  ticket
  order
  payment
  project
  license
  subscription
}

enum SubscriptionNotifyKind {
  d7
  d3
  d1
  expired
}

model Guild {
  id       String   @id
  name     String
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  settings      GuildSettings?
  users         GuildUser[]
  products      Product[]
  idCounters    IdCounter[]
  tickets       Ticket[]
  orders        Order[]
  payments      Payment[]
  licenses      License[]
  subscriptions Subscription[]
  projects      Project[]
  auditLogs     AuditLog[]

  @@map("guilds")
}

model GuildSettings {
  guildId String @id @map("guild_id")
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  ticketPanelChannelId     String? @map("ticket_panel_channel_id")
  ticketCategoryId         String? @map("ticket_category_id")
  customOrderChannelId     String? @map("custom_order_channel_id")
  ticketLogChannelId       String? @map("ticket_log_channel_id")
  paymentLogChannelId      String? @map("payment_log_channel_id")
  orderLogChannelId        String? @map("order_log_channel_id")
  projectLogChannelId      String? @map("project_log_channel_id")
  subscriptionLogChannelId String? @map("subscription_log_channel_id")
  moderationLogChannelId   String? @map("moderation_log_channel_id")
  securityLogChannelId     String? @map("security_log_channel_id")
  botLogChannelId          String? @map("bot_log_channel_id")

  // Per-category ticket Discord category IDs
  tktCatScriptPurchase String? @map("tkt_cat_script_purchase")
  tktCatSupport        String? @map("tkt_cat_support")
  tktCatPayment        String? @map("tkt_cat_payment")
  tktCatDelivery       String? @map("tkt_cat_delivery")
  tktCatCustomProject  String? @map("tkt_cat_custom_project")
  tktCatOther          String? @map("tkt_cat_other")

  // Category for closed/archived tickets
  closedTicketCategoryId String? @map("closed_ticket_category_id")

  ownerRoleId     String? @map("owner_role_id")
  adminRoleId     String? @map("admin_role_id")
  supportRoleId   String? @map("support_role_id")
  developerRoleId String? @map("developer_role_id")
  customerRoleId  String? @map("customer_role_id")

  maxOpenTickets         Int @default(2) @map("max_open_tickets")
  maxOpenPerCategory     Int @default(1) @map("max_open_per_category")
  ticketCloseCooldownSec Int @default(600) @map("ticket_close_cooldown_sec")

  ticketPanelMessageId String? @map("ticket_panel_message_id")

  welcomeEnabled      Boolean @default(false) @map("welcome_enabled")
  welcomeChannelId    String? @map("welcome_channel_id")
  welcomeMessage      String? @map("welcome_message")
  welcomeEmbedEnabled Boolean @default(true) @map("welcome_embed_enabled")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("guild_settings")
}

model GuildUser {
  id        String   @id @default(uuid())
  guildId   String   @map("guild_id")
  discordId String   @map("discord_id")
  username  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordId])
  @@map("users")
}

model Product {
  id          String        @id @default(uuid())
  guildId     String        @map("guild_id")
  name        String
  description String        @default("")
  listPrice   Decimal       @map("list_price") @db.Decimal(12, 2)
  status      ProductStatus @default(ACTIVE)
  version      String        @default("1.0")
  roleId       String?       @map("role_id")
  stock        Int?          @map("stock")
  durationDays Int?          @map("duration_days")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  guild         Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  tickets       Ticket[]
  orders        Order[]
  licenses      License[]
  subscriptions Subscription[]

  @@index([guildId, status])
  @@map("products")
}

model IdCounter {
  guildId String      @map("guild_id")
  kind    CounterKind
  value   Int         @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, kind])
  @@map("id_counters")
}

model Ticket {
  id         String         @id @default(uuid())
  guildId    String         @map("guild_id")
  publicId   String         @map("public_id")
  channelId  String         @unique @map("channel_id")
  openerId   String         @map("opener_id")
  assigneeId String?        @map("assignee_id")
  category   TicketCategory
  status     TicketStatus   @default(WAITING_STAFF)
  productId String?        @map("product_id")
  openedAt  DateTime       @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt  DateTime?      @map("closed_at") @db.Timestamptz(6)

  guild        Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  product      Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  orders       Order[]
  project      Project?
  participants TicketParticipant[]
  messages     TicketMessage[]
  events       TicketEvent[]

  @@unique([guildId, publicId])
  @@index([guildId, openerId, status])
  @@map("tickets")
}

model TicketParticipant {
  ticketId  String @map("ticket_id")
  discordId String @map("discord_id")
  addedBy   String @map("added_by")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([ticketId, discordId])
  @@map("ticket_participants")
}

model TicketMessage {
  id               String   @id @default(uuid())
  ticketId         String   @map("ticket_id")
  discordMessageId String   @unique @map("discord_message_id")
  authorId         String   @map("author_id")
  content          String
  attachments      Json     @default("[]")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketEvent {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  type      String
  actorId   String   @map("actor_id")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

model Order {
  id             String      @id @default(uuid())
  guildId        String      @map("guild_id")
  publicId       String      @map("public_id")
  userId         String      @map("user_id")
  productId      String      @map("product_id")
  ticketId     String?     @unique @map("ticket_id")
  amount       Decimal     @db.Decimal(12, 2)
  currency     String      @db.Char(3)
  access       AccessType
  durationDays Int?        @map("duration_days")
  status       OrderStatus @default(PAYMENT_PENDING)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  guild        Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  ticket       Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  payment      Payment?
  license      License?
  subscription Subscription?

  @@unique([guildId, publicId])
  @@map("orders")
}

model Payment {
  id                String        @id @default(uuid())
  guildId           String        @map("guild_id")
  publicId          String        @map("public_id")
  orderId           String        @unique @map("order_id")
  projectId         String?       @map("project_id")
  userId            String        @map("user_id")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  method            PaymentMethod @default(CRYPTO)
  status            PaymentStatus @default(PAID)
  externalRef       String?       @map("external_ref") @db.VarChar(200)
  confirmedBy       String        @map("confirmed_by")
  confirmedAt       DateTime      @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  loggedToDiscordAt DateTime?     @map("logged_to_discord_at") @db.Timestamptz(6)

  guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([guildId, publicId])
  @@map("payments")
}

model License {
  id        String        @id @default(uuid())
  guildId   String        @map("guild_id")
  publicId  String        @map("public_id")
  key       String        @unique
  userId    String        @map("user_id")
  productId String        @map("product_id")
  orderId   String        @unique @map("order_id")
  status    LicenseStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  guild   Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([guildId, publicId])
  @@map("licenses")
}

model Subscription {
  id          String             @id @default(uuid())
  guildId     String             @map("guild_id")
  publicId    String             @map("public_id")
  userId      String             @map("user_id")
  productId   String             @map("product_id")
  orderId     String             @unique @map("order_id")
  status      SubscriptionStatus
  startedAt   DateTime           @map("started_at") @db.Timestamptz(6)
  expiresAt   DateTime?          @map("expires_at") @db.Timestamptz(6)
  cancelledAt DateTime?          @map("cancelled_at") @db.Timestamptz(6)

  guild         Guild                      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  product       Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  order         Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  notifications SubscriptionNotification[]

  @@index([status, expiresAt])
  @@unique([guildId, publicId])
  @@map("subscriptions")
}

model SubscriptionNotification {
  id             String                 @id @default(uuid())
  subscriptionId String                 @map("subscription_id")
  kind           SubscriptionNotifyKind

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, kind])
  @@map("subscription_notifications")
}

model Project {
  id               String        @id @default(uuid())
  guildId          String        @map("guild_id")
  publicId         String        @map("public_id")
  ticketId         String        @unique @map("ticket_id")
  channelMessageId String?       @map("channel_message_id")
  name             String
  description      String        @default("")
  price            Decimal       @db.Decimal(12, 2)
  deposit          Decimal       @default(0) @db.Decimal(12, 2)
  userId           String        @map("user_id")
  developerId      String?       @map("developer_id")
  status           ProjectStatus @default(APPROVED)
  startsAt         DateTime?     @map("starts_at") @db.Timestamptz(6)
  dueAt            DateTime?     @map("due_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  guild    Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ticket   Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  events   ProjectEvent[]
  payments Payment[]

  @@unique([guildId, publicId])
  @@map("projects")
}

model ProjectEvent {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  type      String
  actorId   String   @map("actor_id")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_events")
}

model AuditLog {
  id         String   @id @default(uuid())
  guildId    String   @map("guild_id")
  actorId    String   @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@map("audit_logs")
}
